# Canopy local development defaults
POSTGRES_DB=canopy
POSTGRES_USER=canopy_user
POSTGRES_PASSWORD=canopy_password
DATABASE_URL=postgresql+psycopg://canopy_user:canopy_password@db:5432/canopy
JWT_SECRET=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000
AUDIO_STORAGE_PATH=/data/audio
# Path to a trained model artifact directory (contains model.pt + config.yaml)
# If not set, the API uses a filename-based demo classifier fallback
AUDIO_MODEL_PATH=
# Path to a metrics.json file produced by research/audio/evaluate.py
# If not set, the API returns demo metrics with is_demo: true
METRICS_PATH=
